# ==========================================
# Payload CMS 3 + Neon Database Environment Variables
# ==========================================

# Neon Postgres Database URI (with SSL and connection pooling)
# Example: postgresql://[user]:[password]@[neon-hostname]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URI=

# Secret key used to encrypt Payload cookies and JWT tokens (min 32 characters)
PAYLOAD_SECRET=your-secure-payload-secret-key-at-least-32-chars

# Public server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ==========================================
# Neon Blob / S3-compatible Object Storage
# ==========================================
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
